{
    "printWidth": 120,
    "singleQuote": true,
    "semi": true,
    "tabWidth": 4,
    "bracketSpacing": true,
    "trailingComma": "none",
    "overrides": [
        {
            "files": "*.html",
            "options": {
                "parser": "angular",
                "singleAttributePerLine": true
            }
        }
    ]
}